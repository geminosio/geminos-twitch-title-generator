{
  "manifest_version": 3,
  "name": "Geminos Twitch Title Generator",
  "version": "1.0.0",
  "description": "Free title ideas for Twitch streamers. Generate creative stream titles locally — no API, no tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
